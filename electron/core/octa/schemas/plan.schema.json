{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octa://planner/plan.schema.json",
  "title": "Octa planner plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["ar-EG", "en", "mixed"] },
    "summary": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "items": { "type": "string" } },
          "blocking": { "type": "boolean" }
        },
        "required": ["id", "text", "why", "options", "blocking"]
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "workflow": {
      "type": "string",
      "enum": ["review-website", "build-website", "market-project", "think-project", "invoice", "research", "custom"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "runner": { "type": "string", "enum": ["codex-scout", "claude-skill", "octa-code", "gemini-inline", "codex-exec"] },
          "skill": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "needs": { "type": "array", "items": { "type": "string" } },
          "gate": { "type": "string", "enum": ["none", "review", "approve"] },
          "autonomy": { "type": "string", "enum": ["led", "assisted", "auto"] },
          "acceptance": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "runner", "needs", "gate", "autonomy", "acceptance"],
        "anyOf": [
          { "required": ["skill"] },
          { "required": ["prompt"] }
        ]
      }
    },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "estimated_minutes": { "type": "number", "minimum": 0 },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "enum": ["accepted", "rejected"] },
          "accepted": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["issue", "reason"],
        "anyOf": [
          { "required": ["decision"] },
          { "required": ["accepted"] }
        ]
      }
    }
  },
  "required": ["plan_id", "language", "summary", "questions", "assumptions", "workflow", "steps", "deliverables", "estimated_minutes"]
}
