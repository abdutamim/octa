# Documentation only. Octa does not read .env at runtime; enter values in Settings.

GEMINI_API_KEY= # Create an AI Studio key in Google AI Studio.
VERTEX_PROJECT_ID= # Use the GCP project with Vertex AI enabled.
VERTEX_SERVICE_ACCOUNT_JSON= # Paste the full path to the downloaded service-account JSON file.
VERTEX_LOCATION=global # Gemini 3.x on Vertex uses the global location.
GROQ_API_KEY= # Optional: create a key in the Groq console for speech fallback.
NTFY_TOPIC= # Create a private topic in the ntfy app; treat it like a password.
NTFY_SERVER=https://ntfy.sh # Use your self-hosted HTTP(S) ntfy server if applicable.
OCTA_HOME_PATH=C:\\Octa # Choose the runtime data folder outside the project.
VAULT_PATH= # Paste the path to the Obsidian vault used as the company brain.
PHOTOSHOP_PATH= # Optional: paste the full path to Photoshop.exe.
BRAVE_SEARCH_API_KEY= # Optional: create a key in the Brave Search API dashboard.
