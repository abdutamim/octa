{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "electron/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "electron.vite.config.ts",
    "vite.renderer.config.ts"
  ]
}
