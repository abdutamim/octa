{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octa://workflows/workflow.schema.json",
  "title": "Octa workflow definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "acceptance", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "autonomy": { "enum": ["led", "assisted", "auto"] },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "needs", "runner", "gate", "autonomy", "acceptance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "needs": { "type": "array", "items": { "type": "string" } },
          "runner": { "type": "string", "minLength": 1 },
          "skill": { "type": "string" },
          "prompt": { "type": "string" },
          "input": {},
          "gate": { "enum": ["none", "review", "approve"] },
          "autonomy": { "enum": ["led", "assisted", "auto"] },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "department": { "type": "string" },
          "todo": { "type": "boolean" },
          "research": { "type": "boolean" },
          "gatePayload": {},
          "timeBudgetMs": { "type": "integer", "minimum": 1 },
          "inputTokenBudget": { "type": "integer", "minimum": 1 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 2 }
        }
      }
    }
  }
}
