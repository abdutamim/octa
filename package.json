{
  "name": "octa",
  "version": "0.1.0",
  "description": "Octa Assistant desktop control center.",
  "main": "./out/main/main.js",
  "author": "Octa contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-rebuild --force --only better-sqlite3,onnxruntime-node --version 42.6.0 --arch x64 && electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "research:demo": "tsx scripts/research-demo.ts",
    "rebuild:electron": "electron-rebuild --force --only better-sqlite3,onnxruntime-node --version 42.6.0 --arch x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --config vitest.config.mjs --configLoader native --pool=threads --no-file-parallelism",
    "test:watch": "vitest --config vitest.config.mjs --configLoader native --pool=threads --no-file-parallelism",
    "build": "npm run typecheck && npm test && electron-vite build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "12.11.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "12.42.2",
    "lucide-react": "0.544.0",
    "onnxruntime-node": "^1.24.3",
    "playwright": "^1.63.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-win32-x64-msvc": "4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "4.1.9"
  }
}
